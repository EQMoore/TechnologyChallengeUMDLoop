<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Friction -->
  <xacro:macro name="wheel_friction" params="link_name mu:=1.0">
    <gazebo reference="${link_name}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction link_name="front_left_wheel_link" mu="0.05"/>
  <xacro:wheel_friction link_name="front_right_wheel_link" mu="0.05"/>
  <xacro:wheel_friction link_name="rear_left_wheel_link"/>
  <xacro:wheel_friction link_name="rear_right_wheel_link"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robotDescription)/config/rover_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
